# =====================================================================
# RAILWAY ENVIRONMENT VARIABLES
# =====================================================================
# Copy and paste these into your Railway Project -> Variables tab:

# 1. Supabase Project Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 2. AI Intelligence Engine (from Google AI Studio)
GEMINI_API_KEY=your-google-gemini-api-key

# 3. Server Configuration
PORT=8000
ALLOWED_ORIGINS=*

# 4. Optional Razorpay Credentials (for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
