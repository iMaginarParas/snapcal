# =============================================================================
# RAILWAY ENVIRONMENT VARIABLES — SabTrack + SabCoach (Shared Project)
# =============================================================================
# Paste these into: Railway Project → Variables
#
# Both SabTrack and SabCoach share ONE Supabase project.
#   · SabTrack  →  `public` schema
#   · SabCoach  →  `coach`  schema
# =============================================================================

# 1. Supabase — from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 2. Google Gemini AI — from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# 3. Server
PORT=8000
ALLOWED_ORIGINS=*

# 4. Razorpay (optional — leave blank to disable payment routes)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
