# =============================================================================
# SabTrack + SabCoach — Shared Supabase Project (Option A)
# =============================================================================
# Both SabTrack and SabCoach live in ONE Supabase project.
#   · SabTrack tables  →  `public` schema
#   · SabCoach tables  →  `coach`  schema
# Tenant isolation is enforced by Row-Level Security (RLS) on each schema.
# =============================================================================

# Port for the FastAPI server (defaults to 3000 locally, 8000 on Railway)
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Service-role key bypasses RLS — use for backend admin ops only. Keep secret!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT secret for verifying user tokens: Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# ── FatSecret (barcode / branded food lookup) ─────────────────────────────────
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# ── USDA FoodData Central ─────────────────────────────────────────────────────
USDA_API_KEY=your-usda-api-key

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── Razorpay (payments) ───────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
